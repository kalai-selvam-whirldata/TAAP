PORT=3000

# Required to use the admin endpoints (GET /api/waitlist, GET /api/waitlist/export.csv).
# Set this to a long random string and send it as the "x-admin-key" header.
ADMIN_API_KEY=change-me-to-a-long-random-value

# --- Google Sheets (OAuth) — where waitlist signups are stored ---
# See README.md "Setting up Google Sheets (OAuth)" for exactly how to get these.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
# Get this by running: node get-refresh-token.js
GOOGLE_REFRESH_TOKEN=paste-the-refresh-token-printed-by-get-refresh-token.js-here
GOOGLE_SHEET_ID=paste-the-id-from-your-sheets-url-here

# Optional: name of the tab/worksheet to write into. Defaults to "Waitlist" if not set.
GOOGLE_SHEET_TAB=Waitlist
